PORT=3002
NODE_ENV=development

# JWT Secret for staff authentication
JWT_SECRET=your-super-secret-key-here-min-32-chars

# Store Information
STORE_NAME=Pak Medical Store
STORE_EMAIL=info@pakmedical.pk
STORE_PHONE=+92-300-1234567

# Database (SQLite - auto-created)
# DATABASE_PATH=./medical_store.db (default)

# License settings
LICENSE_RENEWAL_WARNING_DAYS=30
LICENSE_GRACE_PERIOD_DAYS=7
LICENSE_RENEWAL_COST=5000

# Admin settings
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Payment Gateway Integration (for future)
# JAZZCASH_MERCHANT_ID=your_id
# JAZZCASH_PASSWORD=your_password
# JAZZCASH_PHONE=your_receiving_number

# Email notifications (for future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# WhatsApp integration (for future)
